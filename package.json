{
  "name": "openrotmg-single-player",
  "productName": "Open RotMG Single Player",
  "version": "0.1.5",
  "description": "Offline Open RotMG desktop launcher",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "OpenRotMG contributors",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.renderer.json && node scripts/build.mjs",
    "test": "tsc && node --test tests/*.test.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && node scripts/installer-inputs.mjs check && electron-forge package && node scripts/make-zip.mjs",
    "verify:release": "node scripts/verify-installer.mjs",
    "package:test": "npm test && npm run package && node scripts/package-test.mjs",
    "test:e2e": "node scripts/verify-installer.mjs",
    "test:runtime-updates": "node scripts/runtime-updates-test.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron/asar": "4.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "electron": "45.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  },
  "dependencies": {
    "tar": "7.5.22"
  }
}
